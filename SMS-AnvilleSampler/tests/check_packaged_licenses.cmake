# Verify the actual enabled plugin outputs, not only notice generation.
if(NOT LEGAL_SOURCE OR NOT LEGAL_PATHS)
  message(FATAL_ERROR "Supply the generated legal directory and enabled package paths")
endif()
foreach(name LICENSE HOST-LINKING-EXCEPTION.txt THIRD-PARTY-NOTICES.txt SOURCE.txt)
  file(READ "${LEGAL_SOURCE}/${name}" expected)
  if(expected STREQUAL "")
    message(FATAL_ERROR "Empty legal document: ${name}")
  endif()
  foreach(path IN LISTS LEGAL_PATHS)
    if(NOT EXISTS "${path}/${name}")
      message(FATAL_ERROR "Missing packaged legal document: ${path}/${name}")
    endif()
    file(READ "${path}/${name}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Stale packaged legal document: ${path}/${name}")
    endif()
  endforeach()
endforeach()
